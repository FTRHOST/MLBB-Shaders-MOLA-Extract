#ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
#else
    precision mediump float;
#endif
precision highp int;
uniform 	vec3 _WorldSpaceCameraPos;
uniform 	mediump vec4 _LightShadowData;
uniform 	vec4 _ShadowOffsets[4];
uniform 	vec4 _Diff_ST;
uniform 	vec4 _Light_ST;
uniform 	float _light_PW;
uniform 	vec4 _Em_G_CU_R_MASK_ST;
uniform 	float _Cube_FW;
uniform 	float _Cube_power;
uniform 	float _ES_PW;
uniform 	float _LIGHT;
uniform 	vec4 _Light_C;
uniform 	float _ReceiveShadowsStrength;
uniform 	vec4 _SpecularColor;
uniform 	float _SpecularIntensity;
uniform 	vec4 _LightDir;
uniform 	vec4 _MaskPosition;
uniform 	float _MaskSize;
uniform 	float _ShowMask;
uniform 	float _RoughnessPower;
uniform 	vec4 _FogColor;
uniform 	float _FogHightEnd;
uniform 	float _FogHigh;
uniform 	float _FogHightStart;
uniform 	float _FogLinearEnd;
uniform 	vec3 _FogPosition;
uniform 	float _FogLinearStart;
uniform 	float _CameraON;
uniform lowp sampler2D _Normal;
uniform lowp sampler2D _Light;
uniform lowp sampler2D _Roughness;
uniform lowp sampler2D _Em_G_CU_R_MASK;
uniform lowp samplerCube _Cubemap;
uniform lowp sampler2D _Diff;
uniform lowp sampler2D _FogGradient;
uniform highp sampler2D _ShadowMapTexture;
uniform highp sampler2DShadow hlslcc_zcmp_ShadowMapTexture;
varying highp vec2 vs_TEXCOORD0;
varying highp vec2 vs_TEXCOORD1;
varying highp vec4 vs_TEXCOORD2;
varying highp vec3 vs_TEXCOORD3;
varying highp vec4 vs_TEXCOORD5;
varying highp vec3 vs_TEXCOORD6;
varying highp vec3 vs_TEXCOORD7;
#define SV_Target0 gl_FragData[0]
vec4 u_xlat0;
lowp vec4 u_xlat10_0;
vec4 u_xlat1;
mediump vec3 u_xlat16_1;
lowp vec4 u_xlat10_1;
vec4 u_xlat2;
lowp vec4 u_xlat10_2;
vec3 u_xlat3;
lowp vec3 u_xlat10_3;
vec3 u_xlat4;
vec3 u_xlat5;
lowp vec3 u_xlat10_5;
vec4 u_xlat6;
lowp vec2 u_xlat10_6;
mediump vec3 u_xlat16_7;
vec3 u_xlat8;
lowp vec3 u_xlat10_8;
vec3 u_xlat10;
mediump vec3 u_xlat16_15;
float u_xlat24;
bool u_xlatb24;
float u_xlat26;
float u_xlat27;
float u_xlat28;
float u_xlat29;
void main()
{
    u_xlat0.xyz = vs_TEXCOORD2.xyz + (-_MaskPosition.xyz);
    u_xlat0.x = dot(u_xlat0.xyz, u_xlat0.xyz);
    u_xlat0.x = sqrt(u_xlat0.x);
    u_xlat0.x = u_xlat0.x / _MaskSize;
    u_xlat0.x = (-u_xlat0.x) + 1.0;
    u_xlat0.xyz = u_xlat0.xxx;
    u_xlat0.xyz = clamp(u_xlat0.xyz, 0.0, 1.0);
    u_xlatb24 = _ShowMask==1.0;
    if(u_xlatb24){
        SV_Target0.xyz = u_xlat0.xyz;
        SV_Target0.w = 1.0;
        return;
    }
    u_xlat10_0.xyw = texture2D(_Normal, vs_TEXCOORD0.xy).xyz;
    u_xlat16_1.xyz = u_xlat10_0.xyw * vec3(2.0, 2.0, 2.0) + vec3(-1.0, -1.0, -1.0);
    u_xlat0.xyw = u_xlat16_1.yyy * vs_TEXCOORD7.xyz;
    u_xlat0.xyw = u_xlat16_1.xxx * vs_TEXCOORD6.xyz + u_xlat0.xyw;
    u_xlat0.xyw = u_xlat16_1.zzz * vs_TEXCOORD3.xyz + u_xlat0.xyw;
    u_xlat2.x = dot(u_xlat0.xyw, u_xlat0.xyw);
    u_xlat2.x = inversesqrt(u_xlat2.x);
    u_xlat0.xyw = u_xlat0.xyw * u_xlat2.xxx;
    u_xlat2.x = dot(_LightDir.xyz, _LightDir.xyz);
    u_xlat2.x = inversesqrt(u_xlat2.x);
    u_xlat10.xyz = u_xlat2.xxx * _LightDir.xyz;
    u_xlat3.xyz = _LightDir.xyz * u_xlat2.xxx + (-vs_TEXCOORD2.xyz);
    u_xlat27 = dot(u_xlat3.xyz, u_xlat3.xyz);
    u_xlat27 = inversesqrt(u_xlat27);
    u_xlat3.xyz = vec3(u_xlat27) * u_xlat3.xyz;
    u_xlat27 = dot((-u_xlat3.xyz), u_xlat0.xyw);
    u_xlat27 = u_xlat27 + u_xlat27;
    u_xlat4.xyz = u_xlat0.xyw * (-vec3(u_xlat27)) + (-u_xlat3.xyz);
    u_xlat5.xyz = vs_TEXCOORD5.xyz / vs_TEXCOORD5.www;
    u_xlat6.xyz = u_xlat5.xyz + _ShadowOffsets[0].xyz;
    vec3 txVec0 = vec3(u_xlat6.xy,u_xlat6.z);
    u_xlat1.x = shadow2DEXT(hlslcc_zcmp_ShadowMapTexture, txVec0);
    u_xlat6.xyz = u_xlat5.xyz + _ShadowOffsets[1].xyz;
    vec3 txVec1 = vec3(u_xlat6.xy,u_xlat6.z);
    u_xlat1.y = shadow2DEXT(hlslcc_zcmp_ShadowMapTexture, txVec1);
    u_xlat6.xyz = u_xlat5.xyz + _ShadowOffsets[2].xyz;
    vec3 txVec2 = vec3(u_xlat6.xy,u_xlat6.z);
    u_xlat1.z = shadow2DEXT(hlslcc_zcmp_ShadowMapTexture, txVec2);
    u_xlat5.xyz = u_xlat5.xyz + _ShadowOffsets[3].xyz;
    vec3 txVec3 = vec3(u_xlat5.xy,u_xlat5.z);
    u_xlat1.w = shadow2DEXT(hlslcc_zcmp_ShadowMapTexture, txVec3);
    u_xlat27 = dot(u_xlat1, vec4(0.25, 0.25, 0.25, 0.25));
    u_xlat28 = (-_LightShadowData.x) + 1.0;
    u_xlat27 = u_xlat27 * u_xlat28 + _LightShadowData.x;
    u_xlat16_7.x = u_xlat27 + u_xlat27;
    u_xlat27 = u_xlat27 + -1.0;
    u_xlat27 = _ReceiveShadowsStrength * u_xlat27 + 1.0;
    u_xlat28 = dot(u_xlat0.xyw, u_xlat10.xyz);
    u_xlat28 = max(u_xlat28, 0.0);
    u_xlat5.xy = vs_TEXCOORD1.xy * _Light_ST.xy + _Light_ST.zw;
    u_xlat10_5.xyz = texture2D(_Light, u_xlat5.xy).xyz;
    u_xlat10_6.xy = texture2D(_Roughness, vs_TEXCOORD0.xy).xy;
    u_xlat29 = u_xlat10_6.x * u_xlat10_6.x;
    u_xlat29 = max(u_xlat29, 0.00200000009);
    u_xlat6.xzw = _LightDir.xyz * u_xlat2.xxx + u_xlat3.xyz;
    u_xlat2.x = dot(u_xlat6.xzw, u_xlat6.xzw);
    u_xlat2.x = inversesqrt(u_xlat2.x);
    u_xlat6.xzw = u_xlat2.xxx * u_xlat6.xzw;
    u_xlat2.x = dot(u_xlat0.xyw, u_xlat3.xyz);
    u_xlat10.x = dot(u_xlat10.xyz, u_xlat6.xzw);
    u_xlat10.x = clamp(u_xlat10.x, 0.0, 1.0);
    u_xlat0.x = dot(u_xlat0.xyw, u_xlat6.xzw);
    u_xlat0.x = clamp(u_xlat0.x, 0.0, 1.0);
    u_xlat8.x = (-u_xlat29) + 1.0;
    u_xlat24 = abs(u_xlat2.x) * u_xlat8.x + u_xlat29;
    u_xlat8.x = u_xlat28 * u_xlat8.x + u_xlat29;
    u_xlat8.x = u_xlat8.x * abs(u_xlat2.x);
    u_xlat8.x = u_xlat28 * u_xlat24 + u_xlat8.x;
    u_xlat8.x = u_xlat8.x + 9.99999975e-06;
    u_xlat8.x = 0.5 / u_xlat8.x;
    u_xlat24 = u_xlat29 * u_xlat29;
    u_xlat2.x = u_xlat0.x * u_xlat24 + (-u_xlat0.x);
    u_xlat0.x = u_xlat2.x * u_xlat0.x + 1.0;
    u_xlat24 = u_xlat24 * 0.318309873;
    u_xlat0.x = u_xlat0.x * u_xlat0.x + 1.00000001e-07;
    u_xlat0.x = u_xlat24 / u_xlat0.x;
    u_xlat0.x = u_xlat0.x * u_xlat8.x;
    u_xlat0.x = u_xlat0.x * 3.14159274;
    u_xlat0.x = max(u_xlat0.x, 9.99999975e-05);
    u_xlat0.x = sqrt(u_xlat0.x);
    u_xlat0.x = u_xlat28 * u_xlat0.x;
    u_xlat0.x = log2(u_xlat0.x);
    u_xlat0.x = u_xlat0.x * _RoughnessPower;
    u_xlat0.x = exp2(u_xlat0.x);
    u_xlat8.xz = vs_TEXCOORD0.xy * _Em_G_CU_R_MASK_ST.xy + _Em_G_CU_R_MASK_ST.zw;
    u_xlat10_8.xz = texture2D(_Em_G_CU_R_MASK, u_xlat8.xz).xy;
    u_xlat10_2.xzw = textureCube(_Cubemap, u_xlat4.xyz).xyz;
    u_xlat3.xyz = u_xlat10_2.xzw * vec3(vec3(_Cube_power, _Cube_power, _Cube_power));
    u_xlat3.xyz = u_xlat3.xyz * vec3(_Cube_FW);
    u_xlat2.xzw = u_xlat10_2.xzw * vec3(vec3(_Cube_power, _Cube_power, _Cube_power)) + (-u_xlat3.xyz);
    u_xlat2.xzw = u_xlat3.xyz * u_xlat2.xzw + u_xlat3.xyz;
    u_xlat3.x = u_xlat4.y + u_xlat4.y;
    u_xlat2.xzw = u_xlat2.xzw * u_xlat3.xxx;
    u_xlat2.xzw = u_xlat10_8.xxx * u_xlat2.xzw;
    u_xlat2.xzw = u_xlat10_5.xyz * vec3(_light_PW) + u_xlat2.xzw;
    u_xlat3.xy = vs_TEXCOORD0.xy * _Diff_ST.xy + _Diff_ST.zw;
    u_xlat10_3.xyz = texture2D(_Diff, u_xlat3.xy).xyz;
    u_xlat8.x = u_xlat16_7.x * _LIGHT;
    u_xlat4.xyz = u_xlat10_3.xyz * u_xlat8.xxx;
    u_xlat4.xyz = u_xlat4.xyz * _Light_C.xyz;
    u_xlat8.x = u_xlat10_8.z * _ES_PW;
    u_xlat5.xyz = u_xlat10_3.xyz + vec3(-0.220916301, -0.220916301, -0.220916301);
    u_xlat5.xyz = u_xlat10_6.yyy * u_xlat5.xyz + vec3(0.220916301, 0.220916301, 0.220916301);
    u_xlat6.xyz = u_xlat0.xxx * _SpecularColor.xyz;
    u_xlat16_7.x = (-u_xlat10.x) + 1.0;
    u_xlat16_15.x = u_xlat16_7.x * u_xlat16_7.x;
    u_xlat16_15.x = u_xlat16_15.x * u_xlat16_15.x;
    u_xlat16_7.x = u_xlat16_7.x * u_xlat16_15.x;
    u_xlat16_15.xyz = (-u_xlat5.xyz) + vec3(1.0, 1.0, 1.0);
    u_xlat16_7.xyz = u_xlat16_15.xyz * u_xlat16_7.xxx + u_xlat5.xyz;
    u_xlat5.xyz = u_xlat6.xyz * u_xlat16_7.xyz;
    u_xlat0.xzw = u_xlat0.zzz * u_xlat5.xyz;
    u_xlat0.xzw = u_xlat0.xzw * vec3(_SpecularIntensity);
    u_xlat0.xzw = u_xlat2.xzw * u_xlat4.xyz + u_xlat0.xzw;
    u_xlat0.xyz = u_xlat8.xxx * u_xlat10_3.xyz + u_xlat0.xzw;
    u_xlat2.xyz = vec3(u_xlat27) * u_xlat0.xyz;
    u_xlat24 = (-vs_TEXCOORD2.y) + _FogHigh;
    u_xlat24 = -abs(u_xlat24) + _FogHightEnd;
    u_xlat26 = (-_FogHightStart) + _FogHightEnd;
    u_xlat24 = u_xlat24 / u_xlat26;
    u_xlat24 = clamp(u_xlat24, 0.0, 1.0);
    u_xlat24 = (-u_xlat24) + 1.0;
    u_xlat24 = (-u_xlat24) + 1.0;
    u_xlat3.xyz = _WorldSpaceCameraPos.xyz + (-_FogPosition.xyz);
    u_xlat3.xyz = vec3(_CameraON) * u_xlat3.xyz + _FogPosition.xyz;
    u_xlat3.xyz = (-u_xlat3.xyz) + vs_TEXCOORD2.xyz;
    u_xlat26 = dot(u_xlat3.xyz, u_xlat3.xyz);
    u_xlat26 = sqrt(u_xlat26);
    u_xlat26 = (-u_xlat26) + _FogLinearEnd;
    u_xlat3.x = _FogLinearEnd + (-_FogLinearStart);
    u_xlat26 = u_xlat26 / u_xlat3.x;
    u_xlat26 = clamp(u_xlat26, 0.0, 1.0);
    u_xlat26 = (-u_xlat26) + 1.0;
    u_xlat3.x = u_xlat24 * u_xlat26;
    u_xlat3.y = 0.5;
    u_xlat10_1 = texture2D(_FogGradient, u_xlat3.xy);
    u_xlat2.xyz = (-u_xlat2.xyz);
    u_xlat2.w = -1.0;
    u_xlat1 = _FogColor * u_xlat10_1 + u_xlat2;
    u_xlat2.xyz = u_xlat1.xyz * u_xlat3.xxx;
    u_xlat0.xyz = u_xlat0.xyz * vec3(u_xlat27) + u_xlat2.xyz;
    u_xlat0.w = u_xlat3.x * u_xlat1.w + 1.0;
    SV_Target0 = u_xlat0;
    return;
}

