#endif
    u_xlat1.x = u_xlat0.z + (-u_xlat1.x);
    u_xlat12 = max((-u_xlat0.w), u_xlat1.x);
    u_xlat12 = (-u_xlat1.x) + u_xlat12;
    u_xlat12 = _ShadowBias.y * u_xlat12 + u_xlat1.x;
    u_xlat0.z = max(u_xlat12, 9.99999975e-05);
    u_xlat1.xy = _ShadowMapTexture_TexelSize.xy * vec2(-0.5, -0.5);
    u_xlat1.z = 0.0;
