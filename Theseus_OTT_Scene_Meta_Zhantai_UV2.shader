    u_xlat16_3.xyz = u_xlat16_4.xyz * u_xlat16_3.xyz;
    u_xlat0.xyz = u_xlat0.xxx * u_xlat16_3.xyz;
    u_xlat1.xy = vs_TEXCOORD0.zw * _Light_ST.xy + _Light_ST.zw;
    u_xlat16_1.xyz = texture(_Light, u_xlat1.xy).xyz;
    u_xlat16_3.xyz = u_xlat16_1.xyz * vec3(_light_PW);
    u_xlat16_3.xyz = u_xlat16_3.xyz * _Light_C.xyz;
    u_xlat0.xyz = u_xlat0.xyz * u_xlat16_3.xyz;
    u_xlat0.xyz = log2(abs(u_xlat0.xyz));
    u_xlat0.xyz = u_xlat0.xyz * vec3(0.416666657, 0.416666657, 0.416666657);
    u_xlat0.xyz = exp2(u_xlat0.xyz);
    u_xlat0.xyz = u_xlat0.xyz * vec3(1.05499995, 1.05499995, 1.05499995) + vec3(-0.0549999997, -0.0549999997, -0.0549999997);
