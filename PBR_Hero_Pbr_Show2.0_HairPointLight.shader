    u_xlat19.xyz = u_xlat20.xyz * _DirectionalLight_Color.xyz + u_xlat19.xyz;
    u_xlat3.xzw = vec3(u_xlat78) * u_xlat3.xzw;
    u_xlat3.xzw = u_xlat3.xzw * vec3(_Cube_Intensity) + u_xlat19.xyz;
    u_xlat0.xyz = u_xlat0.xyz * u_xlat10_3.yyy + u_xlat3.xzw;
    u_xlat0.xyz = u_xlat0.xyz * u_xlat18.xyz + u_xlat2.xyz;
    u_xlat16_8.xyz = max(u_xlat0.xyz, vec3(0.0, 0.0, 0.0));
    u_xlat0.xyz = log2(u_xlat16_8.xyz);
    u_xlat0.xyz = u_xlat0.xyz * vec3(0.416666657, 0.416666657, 0.416666657);
    u_xlat0.xyz = exp2(u_xlat0.xyz);
    u_xlat0.xyz = u_xlat0.xyz * vec3(1.05499995, 1.05499995, 1.05499995) + vec3(-0.0549999997, -0.0549999997, -0.0549999997);
    u_xlat0.xyz = max(u_xlat0.xyz, vec3(0.0, 0.0, 0.0));
    u_xlat0.xyz = u_xlat0.xyz * vec3(vec3(_Intensity, _Intensity, _Intensity));
    SV_Target0.xyz = u_xlat0.xyz;
    SV_Target0.w = 1.0;
    return;
}

