    u_xlat0.x = u_xlat0.x * _Sanshe2_Power;
    u_xlat0.xyz = u_xlat0.xxx * _Sanshe2_color.xyz;
    u_xlat0.xyz = u_xlat2.xxx * _Sanshe_color.xyz + u_xlat0.xyz;
    u_xlat10_2.xyz = texture2D(_EmissionTex, vs_TEXCOORD0.xy).xyz;
    u_xlat22.xyz = u_xlat10_2.xyz * vec3(0.305306017, 0.305306017, 0.305306017) + vec3(0.682171106, 0.682171106, 0.682171106);
