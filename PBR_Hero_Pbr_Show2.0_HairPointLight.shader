    u_xlat2.xyz = u_xlat2.xyz * vec3(u_xlat80);
    u_xlat80 = _Time.y * _Em_Speed;
    u_xlat80 = sin(u_xlat80);
    u_xlat2.xyz = (-u_xlat2.xyz) * abs(vec3(u_xlat80)) + u_xlat2.xyz;
