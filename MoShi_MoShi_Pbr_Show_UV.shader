    u_xlat30 = exp2(u_xlat30);
    u_xlat30 = u_xlat30 * _Sanshe_Power;
    u_xlat30 = u_xlat10_1.z * u_xlat30;
    u_xlat0.xyz = vec3(u_xlat30) * _Sanshe_color.xyz + u_xlat0.xyz;
    u_xlat1.xzw = vs_TEXCOORD7.xyz / vs_TEXCOORD7.www;
    u_xlat2.xyz = u_xlat1.xzw + _ShadowOffsets[0].xyz;
    vec3 txVec0 = vec3(u_xlat2.xy,u_xlat2.z);
    u_xlat2.x = shadow2DEXT(hlslcc_zcmp_ShadowMapTexture, txVec0);
    u_xlat5.xyz = u_xlat1.xzw + _ShadowOffsets[1].xyz;
    vec3 txVec1 = vec3(u_xlat5.xy,u_xlat5.z);
    u_xlat2.y = shadow2DEXT(hlslcc_zcmp_ShadowMapTexture, txVec1);
    u_xlat5.xyz = u_xlat1.xzw + _ShadowOffsets[2].xyz;
    u_xlat1.xzw = u_xlat1.xzw + _ShadowOffsets[3].xyz;
    vec3 txVec2 = vec3(u_xlat1.xz,u_xlat1.w);
    u_xlat2.w = shadow2DEXT(hlslcc_zcmp_ShadowMapTexture, txVec2);
    vec3 txVec3 = vec3(u_xlat5.xy,u_xlat5.z);
    u_xlat2.z = shadow2DEXT(hlslcc_zcmp_ShadowMapTexture, txVec3);
    u_xlat30 = dot(u_xlat2, vec4(0.25, 0.25, 0.25, 0.25));
    u_xlat1.x = (-_LightShadowData.x) + 1.0;
    u_xlat30 = u_xlat30 * u_xlat1.x + _LightShadowData.x;
    u_xlat1.xzw = vs_TEXCOORD1.xyz + (-unity_ShadowFadeCenterAndType.xyz);
    u_xlat1.x = dot(u_xlat1.xzw, u_xlat1.xzw);
    u_xlat1.x = sqrt(u_xlat1.x);
    u_xlat2.xyz = (-vs_TEXCOORD1.xyz) + _WorldSpaceCameraPos.xyz;
    u_xlat5.x = hlslcc_mtx4x4unity_MatrixV[0].z;
    u_xlat5.y = hlslcc_mtx4x4unity_MatrixV[1].z;
    u_xlat5.z = hlslcc_mtx4x4unity_MatrixV[2].z;
    u_xlat21 = dot(u_xlat2.xyz, u_xlat5.xyz);
    u_xlat1.x = (-u_xlat21) + u_xlat1.x;
    u_xlat1.x = unity_ShadowFadeCenterAndType.w * u_xlat1.x + u_xlat21;
    u_xlat1.x = u_xlat1.x * _LightShadowData.z + _LightShadowData.w;
    u_xlat1.x = clamp(u_xlat1.x, 0.0, 1.0);
    u_xlat16_9.x = u_xlat30 + u_xlat1.x;
    u_xlat16_9.x = clamp(u_xlat16_9.x, 0.0, 1.0);
    u_xlat10_2 = texture2D(unity_ShadowMask, vs_TEXCOORD7.xy);
    u_xlat16_19 = dot(u_xlat10_2, unity_OcclusionMaskSelector);
    u_xlat16_19 = clamp(u_xlat16_19, 0.0, 1.0);
    u_xlat16_9.x = min(u_xlat16_19, u_xlat16_9.x);
    u_xlat30 = max(_Em_Intensity, 0.0);
    u_xlat30 = u_xlat10_1.y * u_xlat30;
    u_xlat1.xyz = vec3(u_xlat30) * vec3(_Em_Color.x, _Em_Color.y, _Em_Color.z);
    u_xlat1.xyz = u_xlat4.xyz * u_xlat1.xyz;
    u_xlat0.xyz = u_xlat0.xyz * u_xlat16_9.xxx + u_xlat1.xyz;
    u_xlat16_9.xyz = max(u_xlat0.xyz, vec3(0.0, 0.0, 0.0));
    u_xlat0.xyz = log2(u_xlat16_9.xyz);
    u_xlat0.xyz = u_xlat0.xyz * vec3(0.416666657, 0.416666657, 0.416666657);
    u_xlat0.xyz = exp2(u_xlat0.xyz);
    u_xlat0.xyz = u_xlat0.xyz * vec3(1.05499995, 1.05499995, 1.05499995) + vec3(-0.0549999997, -0.0549999997, -0.0549999997);
    u_xlat0.xyz = max(u_xlat0.xyz, vec3(0.0, 0.0, 0.0));
    u_xlat0.xyz = u_xlat0.xyz * vec3(_Intensity);
    SV_Target0.xyz = u_xlat0.xyz;
    SV_Target0.w = 1.0;
    return;
}

