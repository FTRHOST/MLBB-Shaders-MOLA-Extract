    u_xlat10_1.xyz = texture2D(_Diff, u_xlat1.xy).xyz;
    u_xlat52 = log2(u_xlat16_51);
    u_xlat52 = u_xlat52 * _Shadows_PW;
    u_xlat52 = exp2(u_xlat52);
    u_xlat16_6.xyz = u_xlat10_16.xyz * vec3(vec3(_CubeIntensity, _CubeIntensity, _CubeIntensity));
    u_xlat1.xyz = u_xlat10_1.xyz * vec3(u_xlat52) + u_xlat16_6.xyz;
    u_xlat1.xyz = u_xlat16_0.xyz * u_xlat1.xyz;
    u_xlat52 = (-vs_TEXCOORD1.y) + _FogHigh;
    u_xlat52 = -abs(u_xlat52) + _FogHightEnd;
    u_xlat16.x = (-_FogHightStart) + _FogHightEnd;
    u_xlat52 = u_xlat52 / u_xlat16.x;
    u_xlat52 = clamp(u_xlat52, 0.0, 1.0);
    u_xlat16_0.x = (-u_xlat52) + 1.0;
    u_xlat16_0.x = (-u_xlat16_0.x) + 1.0;
    u_xlat16.xyz = _WorldSpaceCameraPos.xyz + (-_FogPosition.xyz);
    u_xlat16.xyz = vec3(_CameraON) * u_xlat16.xyz + _FogPosition.xyz;
    u_xlat16.xyz = (-u_xlat16.xyz) + vs_TEXCOORD1.xyz;
    u_xlat52 = dot(u_xlat16.xyz, u_xlat16.xyz);
    u_xlat52 = sqrt(u_xlat52);
    u_xlat52 = (-u_xlat52) + _FogLinearEnd;
    u_xlat16.x = _FogLinearEnd + (-_FogLinearStart);
    u_xlat52 = u_xlat52 / u_xlat16.x;
    u_xlat52 = clamp(u_xlat52, 0.0, 1.0);
    u_xlat16_17 = (-u_xlat52) + 1.0;
    u_xlat16_0.x = u_xlat16_17 * u_xlat16_0.x;
    u_xlat16_0.y = 0.5;
    u_xlat10_16.xyz = texture2D(_FogGradient, u_xlat16_0.xy).xyz;
    u_xlat16.xyz = _FogColor.xyz * u_xlat10_16.xyz + (-u_xlat1.xyz);
    u_xlat1.xyz = u_xlat16_0.xxx * u_xlat16.xyz + u_xlat1.xyz;
    SV_Target0.xyz = u_xlat1.xyz;
    SV_Target0.w = 1.0;
    return;
}

